{
  // AKSIEMAN static one-page site, served straight from Cloudflare assets.
  // Deploy with: npx wrangler deploy
  "name": "aksieman",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "aksieman.com", "custom_domain": true },
    { "pattern": "www.aksieman.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
