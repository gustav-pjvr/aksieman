{
  // AKSIEMAN — static one-page site served as a Cloudflare Worker (assets-only).
  // Deploy with: npx wrangler deploy
  "name": "aksieman",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
